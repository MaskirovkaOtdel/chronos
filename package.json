{
  "name": "chronos",
  "version": "0.0.0",
  "private": true,
  "description": "CHRONOS — the focus timer that doesn't guilt you.",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "themes:derive": "node scripts/derive-themes.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yaml,yml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  }
}
