{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      // ^build = upstream packages first, so a package's project references
      // resolve and its dependencies' declarations already exist.
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      // Vitest runs TypeScript from source, so a package needs no build of its
      // own — only its dependencies' dist, which is what ^build provides.
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
